# ============================================================
# GORER MART — ENVIRONMENT VARIABLES
# ============================================================
# Copy to .env (local) and set the same values in your Vercel
# project settings. Never commit real values — .env is gitignored.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle and are
# therefore public. Everything else is server-only and must never
# be prefixed with NEXT_PUBLIC_.
# ============================================================

# ---------- Site ----------
# Canonical origin. Drives metadata, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://gorermart.in

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
# SERVER ONLY — bypasses Row Level Security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ---------- Sanity CMS ----------
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
# SERVER ONLY — read token is sufficient for the storefront.
SANITY_API_TOKEN=your_sanity_api_token

# ---------- Razorpay ----------
# Use rzp_live_* keys in production; rzp_test_* only for local testing.
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
# SERVER ONLY — signs and verifies payments.
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# SERVER ONLY — set this to the secret you enter in the Razorpay dashboard when
# creating the webhook pointing at https://<your-domain>/api/webhook/razorpay
# Subscribe the webhook to: payment.captured, payment.failed, refund.processed
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
